{
  "name": "@kumo-vue/tokens",
  "version": "0.1.0",
  "description": "Design tokens for Kumo Vue - semantic colour, spacing, radius and type scales as CSS custom properties and JavaScript values.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HELMAB/kumo-vue.git",
    "directory": "packages/tokens"
  },
  "homepage": "https://github.com/HELMAB/kumo-vue/tree/master/packages/tokens#readme",
  "bugs": {
    "url": "https://github.com/HELMAB/kumo-vue/issues"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./styles": "./dist/tokens.css",
    "./primitives": "./dist/primitives.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "NOTICE",
    "LICENSES"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "contrast": "node scripts/check-contrast.js",
    "test": "node --test 'test/*.test.js'",
    "prepublishOnly": "npm run build",
    "prepack": "node -e \"for (const f of ['LICENSE','NOTICE','LICENSES']) require('fs').cpSync('../../'+f, f, {recursive: true})\""
  },
  "keywords": [
    "design-tokens",
    "vue",
    "css-custom-properties",
    "kumo",
    "design-system"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
