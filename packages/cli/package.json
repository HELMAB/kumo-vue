{
  "name": "kumo-vue",
  "version": "0.1.0",
  "description": "Add Kumo Vue components to your Vue 3 project. Copies source into your repo - you own it from there.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HELMAB/kumo-vue.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/HELMAB/kumo-vue/tree/master/packages/cli#readme",
  "bugs": {
    "url": "https://github.com/HELMAB/kumo-vue/issues"
  },
  "type": "module",
  "bin": {
    "kumo-vue": "bin/kumo-vue.js"
  },
  "files": [
    "bin",
    "src",
    "registry",
    "README.md",
    "LICENSE",
    "NOTICE",
    "LICENSES"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build-registry.js",
    "test": "node --test 'test/*.test.js'",
    "prepublishOnly": "npm run build",
    "prepack": "node -e \"for (const f of ['LICENSE','NOTICE','LICENSES']) require('fs').cpSync('../../'+f, f, {recursive: true})\""
  },
  "keywords": [
    "vue",
    "components",
    "kumo",
    "design-system",
    "cli"
  ],
  "publishConfig": {
    "access": "public"
  }
}
